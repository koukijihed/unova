# Exemple de variables d'environnement — aucune valeur réelle.
# Copier ce fichier vers .env.local, puis renseigner les valeurs localement.

# Supabase — clé publique (exposée au navigateur)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Serveur uniquement — ne jamais exposer au navigateur
# Clé secrète Supabase
SUPABASE_SECRET_KEY=
# Secret aléatoire utilisé pour l'empreinte HMAC des CIN
CIN_PEPPER=
